# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Weekly report email (Resend — resend.com). Server-only.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=PhonicsFlow <reports@yourdomain.com>

# Shared secret Vercel Cron presents when calling the weekly report endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Used for the "Open PhonicsFlow" link in the email. Optional on Vercel.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- SMTP alternative (Gmail, Zoho, Outlook, your host) -----------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=ohoz vjhq fwvf vztl